# Application Environment
NODE_ENV=development

# Web Application (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# API (NestJS)
PORT=4000

# Database (PostgreSQL)
# Use a local database running in Docker for development
DATABASE_URL="postgresql://postgres:postgres@db:5432/signal?schema=public"

# Authentication (JWT)
# Generate a strong secret for production. For local development, this default is fine.
JWT_SECRET=local-dev-secret-do-not-use-in-prod
