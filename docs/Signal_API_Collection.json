{
  "info": {
    "name": "Signal API Collection",
    "description": "API collection for the Signal SaaS application, updated with Phase 6 (Lead Management).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Phase 5: Auth",
      "description": "Authentication endpoints.",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.access_token) {",
                  "    pm.collectionVariables.set(\"jwt_token\", response.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@wayne.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Phase 4: Leads Capture (Public)",
      "description": "Endpoints related to public Lead capture from the marketing website.",
      "item": [
        {
          "name": "Capture Lead",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bruce Wayne\",\n  \"email\": \"bruce@wayneenterprises.com\",\n  \"company\": \"Wayne Enterprises\",\n  \"source\": \"Postman Collection\",\n  \"consent_granted\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/leads/capture",
              "host": ["{{baseUrl}}"],
              "path": ["leads", "capture"]
            }
          }
        }
      ]
    },
    {
      "name": "Phase 6: Lead Management (Internal)",
      "description": "Endpoints for internal dashboard lead management (fetching, updating, follow-ups).",
      "item": [
        {
          "name": "Get All Leads",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-tenant-id",
                "value": "mock-tenant-1"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/leads",
              "host": ["{{baseUrl}}"],
              "path": ["leads"]
            }
          }
        },
        {
          "name": "Get Single Lead",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-tenant-id",
                "value": "mock-tenant-1"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/leads/:id",
              "host": ["{{baseUrl}}"],
              "path": ["leads", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "ENTER_LEAD_ID_HERE"
                }
              ]
            }
          }
        },
        {
          "name": "Update Lead Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-tenant-id",
                "value": "mock-tenant-1"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Contacted\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/leads/:id",
              "host": ["{{baseUrl}}"],
              "path": ["leads", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "ENTER_LEAD_ID_HERE"
                }
              ]
            }
          }
        },
        {
          "name": "Log Follow-Up Activity",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-tenant-id",
                "value": "mock-tenant-1"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"actionType\": \"Email\",\n  \"notes\": \"Sent a welcome email to verify API integration.\",\n  \"status\": \"Completed\",\n  \"scheduledAt\": \"2026-11-11T12:00:00Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/leads/:id/follow-ups",
              "host": ["{{baseUrl}}"],
              "path": ["leads", ":id", "follow-ups"],
              "variable": [
                {
                  "key": "id",
                  "value": "ENTER_LEAD_ID_HERE"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
